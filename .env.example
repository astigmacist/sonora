# Free web AI through OpenRouter. No local model or cloud workspace is required.
# Keep the real key only in .env; never expose it through a VITE_ variable.
SONORA_AI_ENABLED=true
SONORA_AI_PROVIDER=openrouter
SONORA_AI_BASE_URL=https://openrouter.ai/api/v1
SONORA_AI_MODEL=minimax/minimax-m3:free
SONORA_AI_API_KEY=
SONORA_AI_TIMEOUT=90
SONORA_AI_MAX_RESPONSE_BYTES=1048576
SONORA_AI_REQUESTS_PER_HOUR=10
SONORA_AI_REQUESTS_PER_DAY=40
SONORA_SITE_URL=http://localhost:5173

VITE_API_BASE_URL=http://localhost:8765/api
SONORA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local SQLite database used by the progress API.
SONORA_DB_PATH=backend/sonora.db
